# Recorded mode works with a normal laptop and no model/API credentials.
FRONTDOOR_ENABLE_LIVE=false
FRONTDOOR_WORKER_URL=http://127.0.0.1:8141
FRONTDOOR_DB=data/frontdoor.db

# Optional local Laya worker. The download script creates this directory.
FRONTDOOR_ADAPTER_DIR=data/specialist
# FRONTDOOR_DEVICE=cuda
# Optional AWS credentials stay in your AWS profile, never in this file.
